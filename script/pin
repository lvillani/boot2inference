#!/usr/bin/env bash
#
# Pin the latest build so tools like `nh clean all` keep it.
#
# Usage: script/build && script/pin

set -Eeuo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
B2I_PROFILE="${B2I_PROFILE:-$HOME/.local/state/nix/profiles/boot2inference}"

nix-env --profile "$B2I_PROFILE" --set "$(readlink -f "$HERE/../result")"
