#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

HERE="$(cd "$(dirname "$0")" && pwd)"
TOP_LEVEL="$(cd "$HERE/../" && pwd)"

B2I_WIFI_ENABLE="${B2I_WIFI_ENABLE:-0}"
B2I_WIFI_SSID_REF="${B2I_WIFI_SSID_REF:-op://Private/boot2inference-wifi/ssid}"
B2I_WIFI_PSK_REF="${B2I_WIFI_PSK_REF:-op://Private/boot2inference-wifi/password}"
B2I_SSH_PUBKEY_REF="${B2I_SSH_PUBKEY_REF:-op://Private/boot2inference-ssh/public key}"

if [[ "$B2I_WIFI_ENABLE" == "1" || -z "${B2I_SSH_PUBKEY:-}" ]]; then
  command -v op >/dev/null || {
    echo "error: op cli not found (set B2I_WIFI_ENABLE=0 and B2I_SSH_PUBKEY to build without 1password)" >&2
    exit 1
  }
fi

if [[ "$B2I_WIFI_ENABLE" == "1" ]]; then
  B2I_WIFI_SSID="$(op read "$B2I_WIFI_SSID_REF")"
  B2I_WIFI_PSK="$(op read "$B2I_WIFI_PSK_REF")"
  export B2I_WIFI_SSID B2I_WIFI_PSK
fi

if [[ -z "${B2I_SSH_PUBKEY:-}" ]]; then
  B2I_SSH_PUBKEY="$(op read "$B2I_SSH_PUBKEY_REF")"
  export B2I_SSH_PUBKEY
fi

cd "$TOP_LEVEL"

nix run .#nom -- build --impure .#nixosConfigurations.boot2inference.config.system.build.isoImage

realpath result/iso/*.iso
