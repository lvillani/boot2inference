#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

HERE="$(cd "$(dirname "$0")" && pwd)"
TOP_LEVEL="$(cd "$HERE/../" && pwd)"

WIFI_ENABLE="${WIFI_ENABLE:-0}"
WIFI_SSID_REF="${WIFI_SSID_REF:-op://Private/boot2inference-wifi/ssid}"
WIFI_PSK_REF="${WIFI_PSK_REF:-op://Private/boot2inference-wifi/password}"
SSH_PUBKEY_REF="${SSH_PUBKEY_REF:-op://Private/boot2inference-ssh/public key}"

if [[ "$WIFI_ENABLE" == "1" || -z "${SSH_PUBKEY:-}" ]]; then
  command -v op >/dev/null || {
    echo "error: op cli not found (set WIFI_ENABLE=0 and SSH_PUBKEY to build without 1password)" >&2
    exit 1
  }
fi

if [[ "$WIFI_ENABLE" == "1" ]]; then
  WIFI_SSID="$(op read "$WIFI_SSID_REF")"
  WIFI_PSK="$(op read "$WIFI_PSK_REF")"
  export WIFI_SSID WIFI_PSK
fi

if [[ -z "${SSH_PUBKEY:-}" ]]; then
  SSH_PUBKEY="$(op read "$SSH_PUBKEY_REF")"
  export SSH_PUBKEY
fi

cd "$TOP_LEVEL"

nix run .#nom -- build --impure .#nixosConfigurations.boot2inference.config.system.build.isoImage

realpath result/iso/*.iso
